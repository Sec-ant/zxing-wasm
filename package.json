{
  "name": "zxing-wasm-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882",
  "scripts": {
    "update-hooks": "simple-git-hooks",
    "submodule:init": "git submodule update --init --recursive",
    "submodule:update": "git submodule update --remote vendor/zxing-cpp && git -C vendor/zxing-cpp submodule update --init --recursive",
    "build:wasm": "pnpm --filter zxing-wasm run build:wasm",
    "build:all": "pnpm -s submodule:init && pnpm -s build:wasm && pnpm -s build",
    "build": "pnpm --filter zxing-wasm run build && pnpm -s docs:build",
    "type-check": "pnpm --filter zxing-wasm run type-check",
    "type-check:demo": "pnpm --filter @zxing-wasm/demo run type-check",
    "lint": "biome lint .",
    "format:prettier": "prettier --write .",
    "check:prettier": "prettier --check .",
    "format:biome": "biome format . --write",
    "format": "pnpm -s format:prettier && pnpm -s format:biome",
    "check:biome": "biome check .",
    "check": "pnpm -s check:prettier && pnpm -s check:biome && pnpm -s type-check",
    "lint:fix": "biome lint --write .",
    "fix:biome": "biome check --write .",
    "fix": "pnpm -s format && pnpm -s fix:biome && pnpm -s check",
    "clear:dist": "pnpm --filter zxing-wasm run clear:dist",
    "docs:build": "pnpm --filter @zxing-wasm/typedoc run build",
    "docs:watch": "pnpm --filter @zxing-wasm/typedoc run watch",
    "docs:preview": "pnpm --filter zxing-wasm exec vite preview --outDir ../../artifacts/docs",
    "docs:dev": "conc \"pnpm:docs:preview\" \"pnpm:docs:watch\"",
    "dev": "pnpm -s demo:dev",
    "preview": "pnpm --filter @zxing-wasm/demo run preview",
    "demo:dev": "pnpm --filter @zxing-wasm/demo run dev",
    "demo:build": "pnpm --filter zxing-wasm run build && pnpm --filter @zxing-wasm/demo run build",
    "test": "pnpm --filter zxing-wasm run test",
    "test:ui": "pnpm --filter zxing-wasm run test:ui",
    "bench": "pnpm --filter zxing-wasm run bench",
    "bench:save": "pnpm --filter zxing-wasm run bench:save",
    "bench:compare": "pnpm --filter zxing-wasm run bench:compare",
    "bench:bmf": "pnpm --filter zxing-wasm run bench:bmf",
    "bundlewatch": "bundlewatch --config bundlewatch.config.json",
    "bump-biome:latest": "pnpm add -DE @biomejs/biome@latest",
    "bump-biome:nightly": "pnpm add -DE @biomejs/biome@nightly",
    "sync-emsdk": "bash packages/zxing-wasm/scripts/sync-emsdk.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@changesets/cli": "^2.31.0",
    "bundlewatch": "^0.4.2",
    "concurrently": "catalog:",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "simple-git-hooks": "^2.13.1"
  }
}
